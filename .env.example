# ─── Supabase (EU / Frankfurt region — see §11) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — SERVER ONLY. Never expose to client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Audit writer role — dedicated Postgres role with INSERT-only on audit_logs.
# Application reads/writes use the anon/service key above; audit writes use this.
SUPABASE_AUDIT_DB_URL=postgres://audit_writer:...@db.your-project.supabase.co:5432/postgres

# ─── KMS / Envelope encryption (§10.3) ──────────────────────────────────────
# KEK for wrapping per-patient DEKs. In production this is a reference to
# Supabase Vault or a Railway-side KMS; for local dev, a 32-byte base64 key.
CLINICAL_NOTES_KEK_ID=vault:clinical-notes-kek/v1
CLINICAL_NOTES_KEY_PROVIDER=vault
ALLOW_DEV_KEK_FALLBACK=true
CLINICAL_NOTES_KEK_DEV_KEY=

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_IDLE_TIMEOUT_STAFF_MIN=30
SESSION_IDLE_TIMEOUT_DOCTOR_MIN=15
SESSION_IDLE_TIMEOUT_ADMIN_MIN=15

# ─── PDF generation (Railway service) ──────────────────────────────────────
PDF_SERVICE_URL=http://localhost:3000/api/v1/internal/pdf
PDF_SERVICE_SHARED_SECRET=

# ─── Vercel Cron (audit-chain verifier) ────────────────────────────────────
# Vercel auto-injects Authorization: Bearer <CRON_SECRET> on scheduled calls.
# Generate with: select encode(gen_random_bytes(32), 'base64');
CRON_SECRET=

# ─── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
