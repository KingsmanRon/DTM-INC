# ─── Supabase (EU / Frankfurt region — see §11) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — SERVER ONLY. Never expose to client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── KMS / Envelope encryption (§10.3) ──────────────────────────────────────
# KEK for wrapping per-patient DEKs. Production reads it from Supabase Vault;
# the dev key is for local development.
CLINICAL_NOTES_KEK_ID=vault:clinical-notes-kek/v1
CLINICAL_NOTES_KEY_PROVIDER=vault
# Fail-closed default: when UNSET, the dev-key fallback is ON outside
# production and OFF in production. Set "true" only as a deliberate,
# temporary emergency measure — and verify Vault health first.
#ALLOW_DEV_KEK_FALLBACK=
CLINICAL_NOTES_KEK_DEV_KEY=

# ─── App / branding (white-label, see src/lib/branding.ts) ──────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
#NEXT_PUBLIC_SITE_URL=
# Defaults are the DTM values; a new practice sets these in its Vercel project.
#NEXT_PUBLIC_APP_NAME=
#NEXT_PUBLIC_APP_TITLE=
#NEXT_PUBLIC_APP_DESCRIPTION=

# FR-1 idle timeout (minutes per role) — enforced by the IdleLogout component.
SESSION_IDLE_TIMEOUT_STAFF_MIN=30
SESSION_IDLE_TIMEOUT_DOCTOR_MIN=15
SESSION_IDLE_TIMEOUT_ADMIN_MIN=15

# ─── Handwritten clinical notes (feature-flagged) ───────────────────────────
# Capture + read-back of stylus/Apple Pencil notes, enabled per doctor UUID.
#   NOTES     — capture + view, per allowlisted doctor (migration 0027).
#   FINALISE  — allow LOCKING handwritten notes. Captures a durable PNG in the
#               same transaction (finalised rows are immutable, so it can't be
#               backfilled). Requires migration 0028 applied + verified first.
#   PDF       — clinical-notes PDF export (embeds the durable PNG). Requires 0028.
FEATURE_HANDWRITTEN_NOTES=false
FEATURE_HANDWRITTEN_NOTES_DOCTOR_IDS=
FEATURE_HANDWRITTEN_NOTES_FINALISE=false
FEATURE_HANDWRITTEN_NOTES_PDF=false

# ─── Vercel Cron (audit-chain verifier + outbox drain) ──────────────────────
# Vercel auto-injects Authorization: Bearer <CRON_SECRET> on scheduled calls.
# Generate with: select encode(gen_random_bytes(32), 'base64');
CRON_SECRET=

# ─── Diagnostics (temporary) ───────────────────────────────────────────────
# When "true", logs one [supabase-call] line before each server-side Supabase
# REST/RPC/Auth call (caller, route, table/RPC, action, client type, timestamp)
# so excessive PostgREST set_config / /auth/v1/user traffic can be attributed.
# Leave unset/"false" in steady state — this is a diagnostic aid, not for prod.
SUPABASE_CALL_DEBUG=false

# Removed (dead config, fix-plan item 24): SUPABASE_AUDIT_DB_URL (audits flow
# through the audit_writer-owned RPC via the service key), PDF_SERVICE_URL /
# PDF_SERVICE_SHARED_SECRET (Railway PDF service was never built), SENTRY_DSN
# (no error tracker is wired; reintroduce alongside an actual integration).
